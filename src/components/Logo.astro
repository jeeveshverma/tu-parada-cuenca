---
/**
 * The house mark, drawn for this site after the house's own logo: a roof over a stop marker (a
 * ring with a dot, the "parada"), in the logo's orange. `lockup` and `stack` add the name as live
 * text, set like the logo: "tú parada" over "en Cuenca".
 */
import type { Lang } from '../i18n';
interface Props { variant?: 'mark' | 'lockup' | 'stack'; lang?: Lang; size?: number; class?: string; title?: string }
const { variant = 'mark', lang = 'es', size = 40, class: cls = '', title = 'Tu Parada en Cuenca' } = Astro.props;
const sub = lang === 'en' ? 'Guest house · Cuenca' : 'Casa de huéspedes · Cuenca';
---
{variant === 'mark' && (
  <svg class={`logo-mark ${cls}`} width={size} height={size} viewBox="0 0 100 100" fill="none" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label={title}>
    <path class="logo-roof" d="M14 52L50 20l36 32" stroke-width="9" />
    <path class="logo-roof" d="M70 26v12" stroke-width="9" />
    <circle class="logo-ring" cx="50" cy="66" r="17" stroke-width="8" />
    <circle class="logo-pt" cx="50" cy="66" r="6" />
  </svg>
)}
{variant === 'lockup' && (
  <span class={`logo-lockup ${cls}`} style={`--s:${size}px`}>
    <Astro.self variant="mark" size={size} title={title} />
    <span class="logo-words">
      <span class="logo-name">Tu Parada</span>
      <span class="logo-sub">en Cuenca</span>
    </span>
  </span>
)}
{variant === 'stack' && (
  <span class={`logo-stack ${cls}`}>
    <Astro.self variant="mark" size={size} title={title} />
    <span class="logo-name">Tu Parada en Cuenca</span>
    <span class="logo-sub">{sub}</span>
  </span>
)}

<style>
  .logo-mark { flex: none; }
  .logo-roof { stroke: currentColor; }
  .logo-ring { stroke: var(--gold); }
  .logo-pt { fill: var(--gold); }
  .logo-lockup { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .logo-words { display: grid; line-height: 1; }
  .logo-name { font-family: var(--sans); font-weight: 800; font-size: calc(var(--s, 40px) * 0.46); letter-spacing: 0.02em; text-transform: uppercase; color: var(--ink); white-space: nowrap; }
  .logo-sub { font-family: var(--sans); font-weight: 700; font-size: calc(var(--s, 40px) * 0.3); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-text); margin-top: 4px; white-space: nowrap; }
  .logo-stack { display: inline-grid; justify-items: center; gap: 10px; text-align: center; color: var(--ink); text-decoration: none; }
  .logo-stack .logo-name { font-size: 1.25rem; }
  .logo-stack .logo-sub { font-size: 0.72rem; }
</style>
