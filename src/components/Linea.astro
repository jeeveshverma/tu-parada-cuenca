---
/**
 * "The line": the house drawn as a stop on a transit line, with everything around it as the stops
 * that follow, in order of distance. The name of the house is Tu Parada, "your stop", so the map
 * is a line diagram rather than a street map. Distances are straight-line from the door and the
 * minutes are computed from them (src/lib/geo.ts); the far stops show kilometres only.
 */
import { useT, type Lang } from '../i18n';
import { PLACES } from '../data/places';
import { SITE } from '../data/site';
import { fromHotel, fmtKm } from '../lib/geo';
import Icon from './Icon.astro';
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const { t } = useT(lang);
const stops = PLACES.map((p) => { const g = fromHotel(p.at); return { ...p, km: g.km, min: Math.max(1, Math.round((g.km / 5) * 60)) }; }).sort((a, b) => a.km - b.km);
const walk = stops.filter((s) => s.kind === 'walk');
const ride = stops.filter((s) => s.kind === 'ride');
const dist = (km: number) => (km < 1 ? t('line.metres', { m: Math.round(km * 100) * 10 }) : t('line.km', { km: fmtKm(km, lang) }));
---
<div class:list={['ln', compact && 'ln-compact']}>
  <ol class="ln-list">
    <li class="ln-stop ln-here">
      <span class="ln-dot" aria-hidden="true"></span>
      <div class="ln-body"><strong>{t('line.here')}</strong><span class="ln-meta">{t('line.hereSub')}</span></div>
    </li>
    <li class="ln-leg" aria-hidden="true"><span>{t('line.walk')}</span></li>
    {walk.map((s) => (
      <li class:list={['ln-stop', s.transport && 'ln-tr']}>
        <span class="ln-dot" aria-hidden="true"></span>
        <div class="ln-body">
          <strong>{s.name[lang]}</strong>
          <span class="ln-meta"><b>{t('line.onFoot', { min: s.min })}</b> · {dist(s.km)}</span>
          {!compact && <span class="ln-blurb">{s.blurb[lang]}</span>}
        </div>
      </li>
    ))}
    <li class="ln-leg" aria-hidden="true"><span>{t('line.ride')}</span></li>
    {ride.map((s) => (
      <li class:list={['ln-stop ln-far', s.transport && 'ln-tr']}>
        <span class="ln-dot" aria-hidden="true"></span>
        <div class="ln-body">
          <strong>{s.name[lang]}</strong>
          <span class="ln-meta"><b>{dist(s.km)}</b></span>
          {!compact && <span class="ln-blurb">{s.blurb[lang]}</span>}
        </div>
      </li>
    ))}
  </ol>
  <p class="ln-near">{t('line.near')}</p>
  <p class="ln-links">
    <a class="btn btn-gold" href={SITE.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /> {t('line.open')}</a>
    <a class="btn btn-ghost" href={SITE.directionsUrl} target="_blank" rel="noopener">{t('line.directions')} <Icon name="arrowUpRight" size={16} /></a>
  </p>
</div>

<style>
  .ln { --w: 6px; --dot: 18px; }
  .ln-list { list-style: none; margin: 0; padding: 0; position: relative; display: grid; }
  /* the line itself: a solid orange run for the walk, dashed for the ride */
  .ln-stop, .ln-leg { position: relative; padding-inline-start: 44px; }
  .ln-stop::before, .ln-leg::before { content: ''; position: absolute; inset-inline-start: calc(var(--dot) / 2 - var(--w) / 2 + 4px); top: 0; bottom: 0; width: var(--w); background: var(--gold); }
  .ln-here::before { top: 50%; border-radius: var(--w) var(--w) 0 0; }
  .ln-far::before, .ln-leg:nth-of-type(n + 4)::before { background: repeating-linear-gradient(180deg, var(--gold) 0 8px, transparent 8px 14px); }
  .ln-stop:last-child::before { bottom: 50%; }
  .ln-dot { position: absolute; inset-inline-start: 4px; top: 50%; width: var(--dot); height: var(--dot); margin-top: calc(var(--dot) / -2); border-radius: 50%; background: var(--paper); border: 4px solid var(--ink); z-index: 1; }
  .ln-tr .ln-dot { border-radius: 4px; }
  .ln-here .ln-dot { width: 30px; height: 30px; margin-top: -15px; inset-inline-start: -2px; background: var(--gold); border-color: var(--ink); box-shadow: 0 0 0 6px rgba(232, 137, 28, 0.2); }
  .ln-body { display: grid; gap: 1px; padding-block: 11px; border-bottom: 1px solid var(--line); }
  .ln-stop:last-child .ln-body { border-bottom: 0; }
  .ln-body strong { font-family: var(--display); font-size: 1.3rem; font-weight: 600; color: var(--ink); line-height: 1.2; }
  .ln-here strong { font-size: 1.7rem; }
  .ln-meta { font-size: 0.92rem; color: var(--muted); }
  .ln-meta b { color: var(--gold-text); font-weight: 700; }
  .ln-blurb { font-size: 0.92rem; color: var(--body); }
  .ln-leg { padding-block: 16px 4px; }
  .ln-leg span { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .ln-near { margin: 20px 0 0; max-width: 40em; }
  .ln-links { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; margin: 18px 0 0; }
  @media (min-width: 900px) {
    .ln:not(.ln-compact) .ln-list { grid-template-columns: 1fr 1fr; column-gap: 56px; }
    .ln:not(.ln-compact) .ln-here, .ln:not(.ln-compact) .ln-leg { grid-column: 1 / -1; }
  }
</style>
